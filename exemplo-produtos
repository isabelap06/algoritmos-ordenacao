public class SelecaoProdutos {
    public static void ordenar(Produto[] produtos) {
        for (int i = 0; i < produtos.length - 1; i++) {
            int menor = i;

            for (int j = i + 1; j < produtos.length; j++) {
                if (produtos[j].valorDeVenda()
                        < produtos[menor].valorDeVenda()) {
                    menor = j;
                }
            }

            Produto auxiliar = produtos[i];
            produtos[i] = produtos[menor];
            produtos[menor] = auxiliar;
        }
    }
}
